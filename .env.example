# ─────────────────────────────────────────────────────────────
# Rotary Club of Gayaza — environment variables
# Copy to .env for local development. In Coolify, add these under
# the application's "Environment Variables" tab. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
# PostgreSQL connection string (Coolify: copy the "Postgres URL (internal)" of your database resource)
DATABASE_URL="postgresql://rotary:CHANGE_ME@localhost:5432/rotary_gayaza?schema=public"

# Public URL of the site, no trailing slash. Used for QR codes, sitemap, Open Graph and secure cookies.
APP_URL="https://rotarygayaza.org"

# Long random string. Generate with:  openssl rand -base64 48
AUTH_SECRET="CHANGE_ME"

# ── First admin (optional) ───────────────────────────────────
# If set, the first start creates this SUPER ADMIN. Remove after first login and change the password.
# Alternative: run `node dist/scripts/create-admin.js --email you@club.org` in the container terminal.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Club Administrator"

# Seed verified starter content on start (idempotent — never overwrites edits). true | false
SEED_ON_START="true"
# Demo members/meetings for testing analytics. NEVER enable in production.
SEED_DEMO="false"

# ── Storage (photos, documents) ──────────────────────────────
# local = files under STORAGE_LOCAL_DIR (mount a persistent volume at /app/uploads)
# s3    = any S3-compatible bucket (MinIO on the same VPS, Cloudflare R2, Backblaze B2, AWS S3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/app/uploads"
MAX_UPLOAD_MB="10"
S3_ENDPOINT=""            # e.g. https://minio.example.org  or  https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # public base URL for objects, e.g. https://media.rotarygayaza.org
S3_FORCE_PATH_STYLE="false"   # true for MinIO
# Extra image hosts allowed for Next.js image optimisation (comma-separated), e.g. your S3 public host
IMAGE_REMOTE_HOSTS=""

# ── Event & content discovery ────────────────────────────────
# Built-in scheduler checks District 9213, Rotary-O etc. Nothing is published without review.
INGEST_ENABLED="true"
INGEST_INTERVAL_HOURS="12"
INGEST_HORIZON_DAYS="120"     # how far ahead to import events
CLUB_KEYWORDS="gayaza"        # words that identify the club in district listings
# Secret for POST /api/cron/ingest (Authorization: Bearer <CRON_SECRET>) if you prefer an external scheduler
CRON_SECRET=""

# ── Maps ─────────────────────────────────────────────────────
# Map tile URL template for Leaflet (default: OpenStreetMap tiles)
# Example: https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png (empty = tile.openstreetmap.org, fine for club-site traffic)
NEXT_PUBLIC_MAP_TILE_URL=""

# ── Branding ─────────────────────────────────────────────────
# Optional path/URL to the official club logo (unchanged, from Rotary Brand Center).
# Usually set instead in Admin → Clubs → Rotary Club of Gayaza → Official club logo.
NEXT_PUBLIC_CLUB_LOGO=""

# ── Misc ─────────────────────────────────────────────────────
CLUB_TIMEZONE="Africa/Kampala"
CLUB_UTC_OFFSET="+03:00"
MEMBER_SESSION_DAYS="180"     # how long "Remember this phone" lasts
CONTENT_CACHE_SECONDS="120"   # public content cache (cleared instantly on every admin save)
